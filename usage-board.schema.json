{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://usage-ledger.local/schema/usage-board-v1.json",
  "title": "Usage Board Schema v1",
  "description": "Usage Ledger 的出口协议。任何下游消费者（含 integrations/ 下的插件）只看这个协议，不直接查 usage.db。新增字段允许；原字段语义不得悄悄改变；破坏性变更必须升 schema_version。本文件属于 Usage Ledger Core，不依赖任何下游。",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "privacy",
    "summary",
    "window_days",
    "daily",
    "clients",
    "activity",
    "models",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "generated_at": {
      "type": "string"
    },
    "privacy": {
      "type": "object",
      "required": [
        "paths_included",
        "event_ids_included"
      ],
      "properties": {
        "paths_included": {
          "const": false
        },
        "event_ids_included": {
          "const": false
        }
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "usage_events": {
          "type": "integer",
          "minimum": 0
        },
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "reasoning_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "cache_read_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "cache_write_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "total_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "usage_first_day": {
          "type": [
            "string",
            "null"
          ]
        },
        "usage_last_day": {
          "type": [
            "string",
            "null"
          ]
        },
        "priced_models": {
          "type": "integer",
          "minimum": 0
        },
        "unpriced_models": {
          "type": "integer",
          "minimum": 0
        },
        "estimated_cost_usd_top50_models": {
          "type": [
            "number",
            "null"
          ],
          "description": "没有任何模型匹配到单价时必须为 null，不得折算成 0"
        },
        "pricing": {
          "type": "object",
          "description": "价格来源元数据：手工覆盖 vs 自动同步、源标识、取回时间",
          "properties": {
            "manual": {
              "type": "boolean"
            },
            "auto": {
              "type": "boolean"
            },
            "source": {
              "type": [
                "string",
                "null"
              ]
            },
            "source_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "retrieved_at": {
              "type": [
                "string",
                "null"
              ]
            },
            "models": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "estimated_cost_by_currency": {
          "type": [
            "object",
            "null"
          ],
          "description": "R8-C additive：按币种分列的完整估算（USD 是 USD，CNY 是 CNY，绝不相加、绝不做无汇率表的换算）",
          "additionalProperties": {
            "type": "number"
          }
        }
      }
    },
    "grades": {
      "type": "object",
      "description": "数据等级自动判定结果：TOKEN 能进 token/成本统计，ACTIVITY 只有活动痕迹，UNKNOWN 存储存在但读不出用量。",
      "properties": {
        "counts": {
          "type": "object",
          "properties": {
            "TOKEN": {
              "type": "integer",
              "minimum": 0
            },
            "ACTIVITY": {
              "type": "integer",
              "minimum": 0
            },
            "UNKNOWN": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "by_client": {
          "type": "object",
          "additionalProperties": {
            "enum": [
              "TOKEN",
              "ACTIVITY",
              "UNKNOWN"
            ]
          }
        },
        "opaque": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "window_days": {
      "type": "integer",
      "minimum": 1
    },
    "daily": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "day": {
            "type": "string"
          },
          "client": {
            "type": "string"
          },
          "events": {
            "type": "integer",
            "minimum": 0
          },
          "input": {
            "type": "integer",
            "minimum": 0
          },
          "output": {
            "type": "integer",
            "minimum": 0
          },
          "reasoning": {
            "type": "integer",
            "minimum": 0
          },
          "cache_read": {
            "type": "integer",
            "minimum": 0
          },
          "cache_write": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "clients": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "client": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "mode": {
            "enum": [
              "usage",
              "activity"
            ]
          },
          "data_grade": {
            "enum": [
              "TOKEN",
              "ACTIVITY",
              "UNKNOWN"
            ]
          },
          "events": {
            "type": "integer",
            "minimum": 0
          },
          "input": {
            "type": "integer",
            "minimum": 0
          },
          "output": {
            "type": "integer",
            "minimum": 0
          },
          "reasoning": {
            "type": "integer",
            "minimum": 0
          },
          "cache_read": {
            "type": "integer",
            "minimum": 0
          },
          "cache_write": {
            "type": "integer",
            "minimum": 0
          },
          "first_day": {
            "type": [
              "string",
              "null"
            ]
          },
          "last_day": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "activity": {
      "type": "array"
    },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "model": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "events": {
            "type": "integer",
            "minimum": 0
          },
          "priced": {
            "type": "boolean"
          },
          "cost_usd": {
            "type": [
              "number",
              "null"
            ],
            "description": "Board v1 legacy 字段（R8-D 恢复）：仅 USD priced 模型有值（== cost）；CNY priced 与 unpriced 恒为 null——绝不把 CNY 折算成 USD 塞入"
          },
          "cost": {
            "type": [
              "number",
              "null"
            ],
            "description": "R8-C 起为模型币种下的估算金额（币种见 currency）；未匹配到单价时必须为 null，不得折算成 0"
          },
          "currency": {
            "type": [
              "string",
              "null"
            ],
            "description": "该模型参考单价的币种（USD/CNY）；未定价为 null"
          },
          "pricing_source": {
            "type": [
              "string",
              "null"
            ],
            "description": "manual_verified（人工确认）/ auto_reference（目录候选）/ unpriced（未定价）"
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "client": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "mode": {
            "enum": [
              "usage",
              "activity",
              "unknown"
            ]
          },
          "visibility": {
            "enum": [
              "token",
              "activity",
              "unknown"
            ]
          },
          "data_grade": {
            "enum": [
              "TOKEN",
              "ACTIVITY",
              "UNKNOWN"
            ]
          },
          "grade_basis": {
            "enum": [
              "verified",
              "declared_provisional",
              "found_but_unparsed",
              "not_found",
              "unreadable_store",
              "declared_unverified"
            ]
          },
          "grade_provisional": {
            "type": "boolean"
          },
          "state": {
            "enum": [
              "found",
              "not_found"
            ]
          },
          "files_alive": {
            "type": "integer",
            "minimum": 0
          },
          "files_missing": {
            "type": "integer",
            "minimum": 0
          },
          "records": {
            "type": "integer",
            "minimum": 0
          },
          "path_hint": {
            "type": "string",
            "description": "脱敏提示，不含本机完整路径"
          }
        }
      }
    },
    "opaque_stores": {
      "type": "array",
      "description": "认得出、但读不出用量的本地存储（例如加密数据库）。登记为 UNKNOWN，绝不静默略过。",
      "items": {
        "type": "object",
        "properties": {
          "client": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "mode": {
            "const": "opaque"
          },
          "data_grade": {
            "const": "UNKNOWN"
          },
          "grade_basis": {
            "const": "unreadable_store"
          },
          "state": {
            "enum": [
              "found",
              "not_found"
            ]
          },
          "reason": {
            "type": "string"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "path_hint": {
            "type": "string"
          }
        }
      }
    },
    "automation": {
      "type": "object",
      "description": "可选运行态，由 autopilot.py 写入；新增字段不破坏 Schema v1 消费者。",
      "properties": {
        "status": {
          "enum": [
            "success",
            "failed",
            "partial_failure",
            "no_supported_sources"
          ]
        },
        "exit_code": {
          "type": "integer"
        },
        "last_run_at": {
          "type": "string"
        },
        "finished_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "sources_found": {
          "type": "integer",
          "minimum": 0
        },
        "sources_scanned": {
          "type": "integer",
          "minimum": 0
        },
        "sources_total": {
          "type": "integer",
          "minimum": 0
        },
        "events_seen": {
          "type": "integer",
          "minimum": 0
        },
        "events_inserted": {
          "type": "integer",
          "minimum": 0
        },
        "events_updated": {
          "type": "integer",
          "minimum": 0
        },
        "grades": {
          "type": "object"
        },
        "pricing_status": {
          "type": "string"
        },
        "board_written": {
          "type": "boolean"
        },
        "schedule": {
          "type": "object",
          "description": "自动同步配置状态。enabled=false 表示未配置，前端不得显示为已开启；next_run_at 必须带 next_run_basis 说明推算依据。",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "interval_minutes": {
              "type": [
                "integer",
                "null"
              ]
            },
            "installed_at": {
              "type": [
                "string",
                "null"
              ]
            },
            "method": {
              "type": [
                "string",
                "null"
              ]
            },
            "task_name": {
              "type": [
                "string",
                "null"
              ]
            },
            "next_run_at": {
              "type": [
                "string",
                "null"
              ]
            },
            "next_run_basis": {
              "type": "string"
            },
            "next_run_in_seconds": {
              "type": [
                "integer",
                "null"
              ]
            },
            "note": {
              "type": "string"
            }
          }
        },
        "errors_count": {
          "type": "integer",
          "minimum": 0
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "run_state_file": {
          "type": "string"
        },
        "log_file": {
          "type": "string"
        }
      }
    },
    "dedup": {
      "type": [
        "object",
        "null"
      ],
      "description": "Round 4 additive：dsh 血统重放双跑口径。顶层聚合保持 RAW（default_view=raw）；EFFECTIVE 仅作对照与验收。raw = replay + effective 恒成立。本块缺失或 null 表示账本尚未迁移到 v1。",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "validated",
            "available",
            "off"
          ]
        },
        "method": {
          "type": "string",
          "enum": [
            "lineage_seed_v1"
          ]
        },
        "default_view": {
          "type": "string",
          "enum": [
            "raw",
            "effective"
          ]
        },
        "raw_events": {
          "type": "integer",
          "minimum": 0
        },
        "replay_events": {
          "type": "integer",
          "minimum": 0
        },
        "effective_events": {
          "type": "integer",
          "minimum": 0
        },
        "unresolved_events": {
          "type": [
            "integer",
            "null"
          ],
          "description": "断链/模糊保守保留数；未跑过 replay-mark 时为 null"
        },
        "confidence": {
          "type": "string"
        },
        "marked_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "effective_summary": {
          "type": "object",
          "properties": {
            "usage_events": {
              "type": "integer",
              "minimum": 0
            },
            "input_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "output_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "reasoning_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "cache_read_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "cache_write_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "total_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "estimated_cost_usd_top50_models": {
              "type": [
                "number",
                "null"
              ]
            },
            "priced_models": {
              "type": "integer",
              "minimum": 0
            },
            "unpriced_models": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "by_client": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "client": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "raw": {
                "type": "integer",
                "minimum": 0
              },
              "replay": {
                "type": "integer",
                "minimum": 0
              },
              "effective": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "pricing_coverage": {
      "type": [
        "object",
        "null"
      ],
      "description": "R8 additive：定价覆盖率（Usage pricing coverage，基于有效 input+output tokens）与成本语义标注。token_coverage_pct 不得被读作\"所有费用已精确定价\"。",
      "properties": {
        "effective_models": {
          "type": "integer",
          "minimum": 0
        },
        "priced_models": {
          "type": "integer",
          "minimum": 0
        },
        "unpriced_models": {
          "type": "integer",
          "minimum": 0
        },
        "effective_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "priced_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "unpriced_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "token_coverage_pct": {
          "type": [
            "number",
            "null"
          ]
        },
        "model_coverage_pct": {
          "type": [
            "number",
            "null"
          ]
        },
        "priced_by_source": {
          "type": "object"
        },
        "multi_currency": {
          "type": "boolean"
        },
        "pricing_basis": {
          "type": "string"
        },
        "cost_semantics": {
          "type": "string"
        },
        "as_of": {
          "type": "string"
        }
      }
    }
  }
}